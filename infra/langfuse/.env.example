# Copie para infra/langfuse/.env e gere valores reais. Nunca commite o .env.
# Gerar: openssl rand -hex 32  (ENCRYPTION_KEY precisa de 64 hex)
LANGFUSE_WEB_PORT=3100
LANGFUSE_MINIO_PORT=9190
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=change-me
SALT=change-me
ENCRYPTION_KEY=change-me-64-hex
LF_POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me
REDIS_AUTH=change-me

# Projeto "dev" criado na inicialização; a api usa as mesmas chaves.
LANGFUSE_PUBLIC_KEY=pk-lf-dev-change-me
LANGFUSE_SECRET_KEY=sk-lf-dev-change-me
LANGFUSE_ADMIN_EMAIL=admin@fator-r.local
LANGFUSE_ADMIN_PASSWORD=change-me
