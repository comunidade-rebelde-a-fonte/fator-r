# Copie para .env e ajuste. Nunca commite o .env.
ENV=dev

# Postgres da aplicação
POSTGRES_DB=fator_r
POSTGRES_USER=fator_r_owner
# Role da aplicação (sujeita a RLS); senha aplicada por `make migrate`.
APP_DB_USER=fator_r_app
APP_DB_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
DB_PORT=5432

# API
API_PORT=8000
UPLOAD_DIR=/data/uploads
CORS_ORIGINS='["http://localhost:3000"]'

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Seed inicial (make seed). A senha nunca vai para o código.
SEED_FIRM_NOME="Escritório Piloto"
SEED_USER_EMAIL=analista@escritorio-piloto.com.br
SEED_USER_NOME=Analista
SEED_USER_PASSWORD=change-me

# Usuário do escritório de carga (make seed-carga), opcional
SEED_CARGA_PASSWORD=change-me

# Langfuse self-hosted (make up-langfuse). Chaves iguais às de infra/langfuse/.env.
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-dev-change-me
LANGFUSE_SECRET_KEY=sk-lf-dev-change-me
# Endereço visto de dentro do container da api / endereço aberto no navegador
LANGFUSE_HOST=http://host.docker.internal:3100
LANGFUSE_PUBLIC_URL=http://localhost:3100
LANGFUSE_PROJECT_ID=fator-r-dev

# Claude (agentes). Deixe vazio para usar só templates em dev; obrigatório em prod.
# ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
